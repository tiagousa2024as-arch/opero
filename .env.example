# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/opero_dev"

# ---------------------------------------------------------------------------
# Auth.js
# ---------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Payments (Brazil) — pick ONE provider. Asaas is the Phase-1 default.
# Requires a real merchant account/CNPJ before going live (see PART G).
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER="asaas" # "asaas" | "pagarme" | "mock"
ASAAS_API_KEY=""
ASAAS_BASE_URL="https://api-sandbox.asaas.com/v3"
ASAAS_WEBHOOK_TOKEN=""
PAGARME_API_KEY=""
PAGARME_WEBHOOK_TOKEN=""

# ---------------------------------------------------------------------------
# AWS (used from Phase 2 on — S3 attachments, SES email, Secrets Manager)
# ---------------------------------------------------------------------------
AWS_REGION="sa-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_ATTACHMENTS=""
SES_FROM_EMAIL="no-reply@opero.com.br"

# ---------------------------------------------------------------------------
# WhatsApp (Phase 2)
# ---------------------------------------------------------------------------
WHATSAPP_PROVIDER="meta" # "meta" | "zapi" | "gupshup" | "twilio"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# ---------------------------------------------------------------------------
# Nota Fiscal (Phase 2)
# ---------------------------------------------------------------------------
NFE_PROVIDER="focusnfe" # "focusnfe" | "nfeio" | "enotas"
NFE_API_KEY=""

# ---------------------------------------------------------------------------
# Background jobs (Phase 2 — apps/worker)
# ---------------------------------------------------------------------------
SQS_QUEUE_URL_REMINDERS=""
SQS_QUEUE_URL_BILLING=""

# ---------------------------------------------------------------------------
# Redis (Phase 3) — rate limiting on auth endpoints. Falls back to an
# in-process limiter (per-instance only, resets on redeploy) when unset,
# so this is optional in dev but should be set in production.
# ---------------------------------------------------------------------------
REDIS_URL=""

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV="development"
